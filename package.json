{
    "name": "hsr-randomizer",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
        "predev": "tsx scripts/write-version.ts",
        "build": "tsc -b && vite build",
        "prebuild": "tsx scripts/write-version.ts",
        "pretypecheck": "tsx scripts/write-version.ts",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "preview": "vite preview",
        "update:fallback": "tsx scripts/update-fallback.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint"
        ],
        "*.{js,json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0"
    },
    "optionalDependencies": {
        "@rolldown/binding-darwin-arm64": "1.1.1",
        "@rolldown/binding-darwin-x64": "1.1.1",
        "@rolldown/binding-win32-arm64-msvc": "1.1.1",
        "@rolldown/binding-win32-x64-msvc": "1.1.1",
        "@tailwindcss/oxide-darwin-arm64": "4.3.1",
        "@tailwindcss/oxide-darwin-x64": "4.3.1",
        "@tailwindcss/oxide-win32-arm64-msvc": "4.3.1",
        "@tailwindcss/oxide-win32-x64-msvc": "4.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "tsx": "^4.23.1",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.10"
    }
}
